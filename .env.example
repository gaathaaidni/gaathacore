# Safe local/staging template. Do not add real values to Git.
CORE_ENV=staging
CORE_DATABASE_URL=postgresql://<core_user>:<core_password>@<private-host>:5432/gaathacore_core

# Local Core Compose inputs only; use approved secret injection outside Git.
CORE_POSTGRES_DB=gaathacore_core
CORE_POSTGRES_USER=<core_user>
CORE_POSTGRES_PASSWORD=<core_password>
CORE_POSTGRES_PORT=55432

# Product-owned configuration stays in each product's own deployment environment.
# Do not reuse a product DATABASE_URL as CORE_DATABASE_URL.
# Suite: DATABASE_URL=<suite_database_url>
# POS: DATABASE_URL=<pos_database_url>
# Sentira: DB_HOST=<sentira_db_host>; DB_PASSWORD=<sentira_db_password>
# PostPilot: FLASK_ENV=staging

# Optional product-owned services must be injected by the owning product only.
# REDIS_URL=<product_redis_url>
# CELERY_BROKER_URL=<product_broker_url>
# RABBITMQ_URL=<product_rabbitmq_url>
# MINIO_ENDPOINT=<product_object_storage_endpoint>
# MINIO_ACCESS_KEY=<object_storage_access_key>
# MINIO_SECRET_KEY=<object_storage_secret_key>
# JWT_SECRET=<product_jwt_secret>
# SESSION_SECRET=<product_session_secret>
# AI_PROVIDER_API_KEY=<product_ai_provider_key>
