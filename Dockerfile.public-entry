FROM python:3.12-alpine

WORKDIR /app

COPY public_entry.py /app/public_entry.py
COPY logo.png /app/logo.png

EXPOSE 8765

CMD ["python", "-c", "from wsgiref.simple_server import make_server; from public_entry import public_entry_app; make_server('0.0.0.0', 8765, public_entry_app).serve_forever()"]
