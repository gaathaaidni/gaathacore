{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaatha.tech/contracts/api-envelope.v1.schema.json",
  "title": "GaathaCore API Envelope v1",
  "oneOf": [
    {
      "title": "Success",
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "data", "error", "meta"],
      "properties": {
        "success": { "const": true },
        "data": {},
        "error": { "const": null },
        "meta": { "type": "object", "additionalProperties": true }
      }
    },
    {
      "title": "Error",
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "data", "error", "meta"],
      "properties": {
        "success": { "const": false },
        "data": { "const": null },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNAUTHORIZED",
                "FORBIDDEN",
                "NOT_FOUND",
                "CONFLICT",
                "VALIDATION_ERROR",
                "RATE_LIMITED",
                "INTERNAL_ERROR"
              ]
            },
            "message": { "type": "string", "minLength": 1, "maxLength": 500 },
            "details": { "type": "object", "additionalProperties": true }
          }
        },
        "meta": { "type": "object", "additionalProperties": true }
      }
    }
  ]
}