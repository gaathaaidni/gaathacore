# Example environment variables for Gaatha Suite.
# The backend code loads .env from the backend folder, so copy this file to backend/.env

# Example:
# cp .env.example backend/.env

SECRET_KEY=replace-with-a-strong-secret
# Use the Compose service name for container-to-container traffic.
DATABASE_URL=postgresql+asyncpg://gaatha:gaatha@db:5432/gaatha
REDIS_URL=redis://redis:6379/0
FLASK_ENV=production

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeThisSuperAdminPassword!

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

RESEND_API_KEY=
MAIL_DEFAULT_SENDER="Gaatha Suite <noreply@example.com>"
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

PAYMENT_PROVIDER=cashfree
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=TEST
CASHFREE_RETURN_URL=https://yourdomain.com/pay/cashfree/return
CASHFREE_NOTIFY_URL=https://yourdomain.com/pay/webhook/cashfree

COMPANY_NAME=Your Company Name
COMPANY_EMAIL=support@yourcompany.com
COMPANY_WEBSITE=https://yourcompany.com
COMPANY_JURISDICTION=India
