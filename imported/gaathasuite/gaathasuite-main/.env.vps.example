# VPS production template. Copy to .env on the VPS and replace every placeholder.
# Keep this file private and never commit the populated .env.

APP_ENV=production
BASE_URL=https://gaathasuite.gaatha.tech
CORS_ORIGINS=https://gaathasuite.gaatha.tech
WEB_PORT=5000

POSTGRES_USER=gaatha_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=gaatha
SECRET_KEY=replace-with-at-least-32-random-characters

# Optional integrations. Leave blank when unused.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_DEFAULT_SENDER=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
