# Environment configuration for Gaatha Suite backend

# Application security
SECRET_KEY=replace-with-a-strong-secret-key

# PostgreSQL database connection
DATABASE_URL=postgresql+asyncpg://gaatha:your_db_password@db:5432/gaatha
REDIS_URL=redis://localhost:6379/0
FLASK_ENV=production

# Super Admin credentials for first-time setup
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeThisSuperAdminPassword!

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email configuration
RESEND_API_KEY=
MAIL_DEFAULT_SENDER="Gaatha Suite <noreply@example.com>"
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True

# AI assistant
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Payment provider
PAYMENT_PROVIDER=cashfree
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=TEST
CASHFREE_RETURN_URL=https://yourdomain.com/pay/cashfree/return
CASHFREE_NOTIFY_URL=https://yourdomain.com/pay/webhook/cashfree

# Company defaults (optional)
COMPANY_NAME=Your Company Name
COMPANY_EMAIL=support@yourcompany.com
COMPANY_WEBSITE=https://yourcompany.com
COMPANY_JURISDICTION=India
