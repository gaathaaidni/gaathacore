[Unit]
Description=Gunicorn instance to serve Gaatha Suite (FastAPI)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/workspaces/gaathasuite/backend
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="PORT=5000"
ExecStart=/usr/local/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker -b 0.0.0.0:5000 app.main:app

[Install]
WantedBy=multi-user.target
