# Local API configuration. Copy this file to .env.local before starting the API.
NODE_ENV=development
API_PORT=4000
DB_HOST=localhost # use postgres inside Docker Compose
DB_PORT=5432
DB_USER=sentira
DB_PASSWORD=sentira_dev_password
DB_NAME=sentira

# Replace both values with unique secrets before using a shared environment.
JWT_SECRET=replace-with-a-unique-jwt-signing-secret
STREAM_GATEWAY_INTERNAL_TOKEN=replace-with-a-unique-stream-gateway-token
STREAM_GATEWAY_AUTH_SECRET=replace-with-a-unique-scoped-stream-auth-secret
AI_WORKER_INGEST_TOKEN=replace-with-a-unique-ai-worker-ingest-token
AI_MAX_FRAME_BYTES=10485760

# Required to encrypt and decrypt camera credentials. Generate with:
# openssl rand -base64 48
CAMERA_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Docker service URLs (never use localhost between containers).
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
AI_PROVIDER=deterministic
AI_WORKER_URL=http://ai-worker:8002
SENTIRA_API_URL=http://api:4000/api
STREAM_SEGMENT_SECONDS=2
STREAM_BUFFER_SECONDS=30
