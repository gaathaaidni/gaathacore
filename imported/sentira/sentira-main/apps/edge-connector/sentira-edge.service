[Unit]
Description=Sentira Edge Connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentira-edge
WorkingDirectory=/opt/sentira-edge
ExecStart=/usr/bin/python3 /opt/sentira-edge/main.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sentira-edge

[Install]
WantedBy=multi-user.target
